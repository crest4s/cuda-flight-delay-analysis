# ============================================================================
# .gitignore para Proyecto C++ & CUDA
# ============================================================================

# Archivos compilados y ejecutables
# ============================================================================
*.o
*.obj
*.exe
*.out
*.app
*.a
*.so
*.dylib
*.dll
*.lib

# Directorios de compilación
# ============================================================================
obj/
bin/
build/
dist/
*.build/

# Archivos de datos del dataset (archivos grandes)
# ============================================================================
data/*.csv
data/*.txt
data/*.dat
data/*.bin
*.csv
*.dataset

# Archivos de IDE y editores
# ============================================================================
# Visual Studio Code
.vscode/
*.code-workspace

# CLion / IntelliJ
.idea/
cmake-build-*/

# Vim / Neovim
*.swp
*.swo
*.swn
*~
.*.sw[a-p]

# Emacs
\#*\#
.\#*

# Sublime Text
*.sublime-project
*.sublime-workspace

# Xcode
*.xcodeproj/
*.xcworkspace/
xcuserdata/

# Archivos del sistema operativo
# ============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini

# Linux
.directory
.Trash-*

# Archivos temporales y de log
# ============================================================================
*.tmp
*.temp
*.log
*.bak
*.backup
*.old
*.orig

# CUDA y archivos de profiling
# ============================================================================
# CUDA profiler
*.nvprof
*.nvvp
*.qdrep
nsight-*
*.nsys-rep
*.ncu-rep

# CUDA cache
.nv/

# Archivos de depuración
# ============================================================================
# Core dumps
core
core.*
vgcore.*

# GDB
.gdb_history

# LLDB
.lldb_history

# Valgrind
*.valgrind
vgcore.*

# Archivos de Make y CMake
# ============================================================================
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile.bak
*.make

# Dependencias y librerías
# ============================================================================
*.depend
*.d
*.dep

# Documentación generada
# ============================================================================
docs/_build/
html/
latex/
*.doxygen
doxygen_output/

# Archivos de test y output
# ============================================================================
test_output/
*.test
results/
output/

# Archivos de configuración local
# ============================================================================
.env
.env.local
config.local.*
*.secret


x64